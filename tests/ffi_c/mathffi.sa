10 REM mathffi: 供 C 端反向 FFI 调用的 SA 库
20 REM 覆盖 CONST、多参数、DOUBLE/LONG 两种返回类型
30 CONST E_APPROX AS NUM AS DOUBLE = 2.718281828
40 SUB add(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
50 RETURN a + b
60 .ENDSUB
70 SUB scale(value AS NUM AS DOUBLE, factor AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
80 RETURN value * factor
90 .ENDSUB
100 SUB factorial(n AS NUM AS LONG) AS PUBLIC AS NUM AS LONG
110 DIM result AS NUM AS LONG AS VAR
120 DIM i AS NUM AS LONG AS VAR
130 result = 1
140 i = 1
150 ::loop
160 IF i > n THEN
170 GOTO ::done
180 END IF
190 result = result * i
200 i = i + 1
210 GOTO ::loop
220 ::done
230 RETURN result
240 .ENDSUB
250 SUB is_even(n AS NUM AS LONG) AS PUBLIC AS NUM AS LONG
260 DIM half AS NUM AS LONG AS VAR
270 half = n / 2
280 IF half * 2 = n THEN
290 RETURN 1
300 END IF
310 RETURN 0
320 .ENDSUB
