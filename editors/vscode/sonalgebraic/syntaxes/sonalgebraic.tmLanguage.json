{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SonAlgebraic",
  "scopeName": "source.sonalgebraic",
  "patterns": [
    { "include": "#line-number" },
    { "include": "#comment" },
    { "include": "#label" },
    { "include": "#fstring" },
    { "include": "#string" },
    { "include": "#block-end" },
    { "include": "#declaration-keywords" },
    { "include": "#control-keywords" },
    { "include": "#type-keywords" },
    { "include": "#modifier-keywords" },
    { "include": "#operator-keywords" },
    { "include": "#builtin-functions" },
    { "include": "#constants" },
    { "include": "#number" },
    { "include": "#operators" },
    { "include": "#module-member" },
    { "include": "#identifier" }
  ],
  "repository": {
    "line-number": {
      "comment": "行首强制行号",
      "match": "^\\s*(\\d+)\\b",
      "captures": {
        "1": { "name": "constant.numeric.line-number.sonalgebraic" }
      }
    },
    "comment": {
      "match": "\\b(REM)\\b.*$",
      "name": "comment.line.rem.sonalgebraic"
    },
    "label": {
      "match": "::[A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.name.tag.label.sonalgebraic"
    },
    "fstring": {
      "comment": "F-string，{} 内是表达式",
      "begin": "F\"",
      "end": "\"",
      "name": "string.interpolated.sonalgebraic",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.embedded.expression.sonalgebraic",
          "patterns": [
            { "include": "#operator-keywords" },
            { "include": "#builtin-functions" },
            { "include": "#constants" },
            { "include": "#number" },
            { "include": "#operators" },
            { "include": "#module-member" },
            { "include": "#identifier" }
          ]
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.sonalgebraic"
    },
    "block-end": {
      "match": "(?<=^|\\s)\\.(ENDSUB|ENDIF|ENDENTITY|ENDENUM|ENDFOR|ENDWHILE|ENDTRY)\\b",
      "name": "keyword.control.end-block.sonalgebraic"
    },
    "declaration-keywords": {
      "match": "\\b(DIM|CONST|SUB|USE|USEC|USELIB|DECLARE C|DECLARE|ENTITY|ENUM|FOR ENTITY)\\b",
      "name": "storage.type.declaration.sonalgebraic"
    },
    "control-keywords": {
      "match": "\\b(IF|THEN|ELSE IF|ELSE|END IF|FOR|TO|STEP|WHILE|GOTO|GOSUB|RETURN|CALL|TRY|CATCH|TRACEBACK|THROW|NEW|END|CLS|PRINT|INPUT)\\b",
      "name": "keyword.control.sonalgebraic"
    },
    "type-keywords": {
      "match": "\\b(NUM|STRING|BOOL|ERROR|SYMBOL|HANDLE|CPTR|PTR|VOID|LONG|DOUBLE|FLOAT|LIST|STR_LIST|MAP|STR_MAP|BUFFER|FILE|NET_STREAM|TCP_LISTENER|UDP_SOCKET)\\b",
      "name": "support.type.sonalgebraic"
    },
    "modifier-keywords": {
      "match": "\\b(AS|VAR|REF|PUBLIC|PRIVATE)\\b",
      "name": "storage.modifier.sonalgebraic"
    },
    "operator-keywords": {
      "match": "\\b(AND|OR|NOT|BAND|BOR|BXOR|BNOT|SHL|SHR|CAST)\\b",
      "name": "keyword.operator.word.sonalgebraic"
    },
    "builtin-functions": {
      "match": "\\b(DERIV|SIMPLIFY|SUBST|EVAL|NUMBER|STRING)(?=\\s*\\()",
      "name": "support.function.builtin.sonalgebraic"
    },
    "constants": {
      "match": "\\b(TRUE|FALSE|NULL)\\b",
      "name": "constant.language.sonalgebraic"
    },
    "number": {
      "comment": "十六进制、科学计数、下划线分隔",
      "match": "\\b(0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.sonalgebraic"
    },
    "operators": {
      "match": "\\*\\*|<=|>=|<>|==|!=|[-+*/<>=^@]",
      "name": "keyword.operator.sonalgebraic"
    },
    "module-member": {
      "comment": "模块成员访问，如 L.PUSH、SYS.MATH",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.sonalgebraic" },
        "2": { "name": "variable.other.member.sonalgebraic" }
      }
    },
    "identifier": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.sonalgebraic"
    }
  }
}
