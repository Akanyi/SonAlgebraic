10 REM 第一批特性验证：ELSE/ELSE IF、BOOL/TRUE/FALSE、NULL、数值字面量
20 DIM hexval AS NUM AS LONG AS VAR
30 DIM sci AS NUM AS DOUBLE AS VAR
40 DIM big AS NUM AS LONG AS VAR
50 DIM flag AS BOOL AS VAR
60 DIM p AS PTR TO NUM AS LONG AS VAR
70 SUB grade(score AS NUM AS LONG) AS NUM AS LONG
80 IF score >= 90 THEN
90 RETURN 4
100 ELSE IF score >= 80 THEN
110 RETURN 3
120 ELSE IF score >= 60 THEN
130 RETURN 2
140 ELSE
150 RETURN 0
160 END IF
170 .ENDSUB
180 SUB main AS PUBLIC AS VOID
190 hexval = 0xFF
200 sci = 1.5e3
210 big = 1_000_000
220 flag = TRUE
230 p = NULL
240 PRINT F"hex={hexval} sci={sci} big={big}"
250 IF flag AND hexval > 100 THEN
260 PRINT "flag on and hex big"
270 END IF
280 IF p = NULL THEN
290 PRINT "p is null"
300 END IF
310 DIM g AS NUM AS LONG AS VAR
320 g = CALL grade(85)
330 PRINT F"grade of 85 = {g}"
340 g = CALL grade(50)
350 PRINT F"grade of 50 = {g}"
360 .ENDSUB
370 CALL main
380 END
