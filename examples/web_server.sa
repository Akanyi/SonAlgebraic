10 REM 迷你 HTTP server：单线程 accept 循环，按路径路由。访问 /quit 可以关掉它。
20 USE SYS.NET AS N
30 USE SYS.STRING AS S
50 SUB request_path(head AS STRING) AS STRING
60 DIM gap AS NUM AS LONG AS VAR
70 DIM rest AS STRING AS VAR
80 gap = S.FIND(head, " ")
90 IF gap < 0 THEN
100 RETURN "/"
110 .ENDIF
120 rest = S.SLICE(head, gap + 1, S.LENGTH(head))
130 gap = S.FIND(rest, " ")
140 IF gap < 0 THEN
150 RETURN rest
160 .ENDIF
170 RETURN S.SLICE(rest, 0, gap)
180 .ENDSUB
200 SUB respond(conn AS HANDLE AS NET_STREAM, status AS STRING, body AS STRING) AS NUM AS LONG
210 RETURN N.STREAM_SEND(conn, F"HTTP/1.1 {status}\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {S.LENGTH(body)}\r\nConnection: close\r\n\r\n{body}")
220 .ENDSUB
240 SUB serve_one(conn AS HANDLE AS NET_STREAM) AS BOOL
250 DIM request AS STRING AS VAR
260 DIM path AS STRING AS VAR
270 DIM sent AS NUM AS LONG AS VAR
290 request = N.STREAM_RECV(conn, 4096)
300 path = CALL request_path(request)
310 PRINT F"{N.LAST_PEER_HOST()} {path}"
320 IF path = "/quit" THEN
330 sent = CALL respond(conn, "200 OK", "bye")
340 RETURN FALSE
350 .ENDIF
360 IF path = "/hello" THEN
370 sent = CALL respond(conn, "200 OK", "hello from SonAlgebraic")
380 RETURN TRUE
390 .ENDIF
400 IF path = "/" THEN
410 sent = CALL respond(conn, "200 OK", "index: try /hello or /quit")
420 RETURN TRUE
430 .ENDIF
440 sent = CALL respond(conn, "404 Not Found", "no such path")
450 RETURN TRUE
460 .ENDSUB
470 DIM listener AS HANDLE AS TCP_LISTENER AS VAR
480 DIM conn AS HANDLE AS NET_STREAM AS VAR
490 DIM running AS BOOL AS VAR
500 DIM ok AS BOOL AS VAR
510 SUB main AS PUBLIC AS VOID
520 listener = N.TCP_LISTEN("127.0.0.1", 8080, 16)
530 IF listener = NULL THEN
540 PRINT F"listen failed: {N.LAST_ERROR()}"
550 RETURN
560 .ENDIF
570 PRINT F"listening on http://127.0.0.1:{N.LOCAL_PORT(listener)}"
580 running = TRUE
590 WHILE running
610 conn = N.TCP_ACCEPT(listener, 30000)
620 IF conn = NULL THEN
630 PRINT "idle timeout"
640 running = FALSE
650 ELSE
660 running = CALL serve_one(conn)
670 ok = N.STREAM_CLOSE(conn)
680 .ENDIF
690 .ENDWHILE
700 ok = N.TCP_LISTENER_CLOSE(listener)
710 PRINT "server stopped"
720 .ENDSUB
730 CALL main
740 END
