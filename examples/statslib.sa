10 CONST PASS_LINE AS NUM AS DOUBLE = 60.0
20 CONST PERFECT AS NUM AS DOUBLE = 100.0
30 SUB average(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
40 RETURN (a + b + c) / 3.0
50 .ENDSUB
60 SUB weighted(midterm AS NUM AS DOUBLE, final AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
70 RETURN midterm * 0.4 + final * 0.6
80 .ENDSUB
90 SUB passed(score AS NUM AS DOUBLE) AS PUBLIC AS NUM AS LONG
100 IF score >= PASS_LINE THEN
110 RETURN 1
120 END IF
130 RETURN 0
140 .ENDSUB
150 SUB clamp(score AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
160 IF score > PERFECT THEN
170 RETURN PERFECT
180 END IF
190 IF score < 0 THEN
200 RETURN 0.0
210 END IF
220 RETURN score
230 .ENDSUB
