10 USEC <math.h> AS C
20 USELIB "m" AS M_LIB
30 DECLARE C SUB C.sin(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
40 DECLARE C SUB C.cos(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
50 DECLARE C SUB C.tan(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
60 DECLARE C SUB C.asin(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
70 DECLARE C SUB C.acos(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
80 DECLARE C SUB C.atan(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
90 DECLARE C SUB C.atan2(y AS NUM AS DOUBLE, x AS NUM AS DOUBLE) AS NUM AS DOUBLE
100 DECLARE C SUB C.sinh(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
110 DECLARE C SUB C.cosh(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
120 DECLARE C SUB C.tanh(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
130 DECLARE C SUB C.exp(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
140 DECLARE C SUB C.log(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
150 DECLARE C SUB C.log10(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
160 DECLARE C SUB C.log2(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
170 DECLARE C SUB C.pow(base AS NUM AS DOUBLE, exponent AS NUM AS DOUBLE) AS NUM AS DOUBLE
180 DECLARE C SUB C.sqrt(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
190 DECLARE C SUB C.cbrt(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
200 DECLARE C SUB C.fabs(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
210 DECLARE C SUB C.floor(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
220 DECLARE C SUB C.ceil(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
230 DECLARE C SUB C.round(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
240 DECLARE C SUB C.trunc(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
250 DECLARE C SUB C.fmod(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS NUM AS DOUBLE
260 DECLARE C SUB C.remainder(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS NUM AS DOUBLE
270 DECLARE C SUB C.hypot(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS NUM AS DOUBLE
280 DECLARE C SUB C.erf(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
290 DECLARE C SUB C.erfc(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
300 DECLARE C SUB C.tgamma(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
310 DECLARE C SUB C.lgamma(x AS NUM AS DOUBLE) AS NUM AS DOUBLE
400 CONST PI AS NUM AS DOUBLE = 3.14159265358979323846
410 CONST E AS NUM AS DOUBLE = 2.71828182845904523536
420 CONST TAU AS NUM AS DOUBLE = 6.28318530717958647692
430 CONST SQRT2 AS NUM AS DOUBLE = 1.41421356237309504880
440 CONST EPSILON AS NUM AS DOUBLE = 2.2204460492503131e-16
450 CONST DEG_TO_RAD AS NUM AS DOUBLE = 0.01745329251994329577
460 CONST RAD_TO_DEG AS NUM AS DOUBLE = 57.2957795130823208768
470 CONST GOLDEN_RATIO AS NUM AS DOUBLE = 1.61803398874989484820
500 SUB sin(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
510 RETURN C.sin(x)
520 .ENDSUB
530 SUB cos(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
540 RETURN C.cos(x)
550 .ENDSUB
560 SUB tan(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
570 RETURN C.tan(x)
580 .ENDSUB
590 SUB asin(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
600 RETURN C.asin(x)
610 .ENDSUB
620 SUB acos(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
630 RETURN C.acos(x)
640 .ENDSUB
650 SUB atan(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
660 RETURN C.atan(x)
670 .ENDSUB
680 SUB atan2(y AS NUM AS DOUBLE, x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
690 RETURN C.atan2(y, x)
700 .ENDSUB
710 SUB sinh(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
720 RETURN C.sinh(x)
730 .ENDSUB
740 SUB cosh(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
750 RETURN C.cosh(x)
760 .ENDSUB
770 SUB tanh(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
780 RETURN C.tanh(x)
790 .ENDSUB
800 SUB exp(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
810 RETURN C.exp(x)
820 .ENDSUB
830 SUB exp2(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
840 RETURN C.pow(2.0, x)
850 .ENDSUB
860 SUB log(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
870 RETURN C.log(x)
880 .ENDSUB
890 SUB log10(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
900 RETURN C.log10(x)
910 .ENDSUB
920 SUB log2(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
930 RETURN C.log2(x)
940 .ENDSUB
950 SUB log1p(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
960 RETURN C.log(1.0 + x)
970 .ENDSUB
980 SUB pow(base AS NUM AS DOUBLE, exponent AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
990 RETURN C.pow(base, exponent)
1000 .ENDSUB
1010 SUB square(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1020 RETURN x * x
1030 .ENDSUB
1040 SUB cube(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1050 RETURN x * x * x
1060 .ENDSUB
1070 SUB sqrt(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1080 RETURN C.sqrt(x)
1090 .ENDSUB
1100 SUB cbrt(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1110 RETURN C.cbrt(x)
1120 .ENDSUB
1130 SUB abs(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1140 RETURN C.fabs(x)
1150 .ENDSUB
1160 SUB floor(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1170 RETURN C.floor(x)
1180 .ENDSUB
1190 SUB ceil(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1200 RETURN C.ceil(x)
1210 .ENDSUB
1220 SUB round(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1230 RETURN C.round(x)
1240 .ENDSUB
1250 SUB trunc(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1260 RETURN C.trunc(x)
1270 .ENDSUB
1280 SUB mod(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1290 RETURN C.fmod(x, y)
1300 .ENDSUB
1310 SUB remainder(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1320 RETURN C.remainder(x, y)
1330 .ENDSUB
1340 SUB hypot(x AS NUM AS DOUBLE, y AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1350 RETURN C.hypot(x, y)
1360 .ENDSUB
1370 SUB deg_to_rad(degrees AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1380 RETURN degrees * DEG_TO_RAD
1390 .ENDSUB
1400 SUB rad_to_deg(radians AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1410 RETURN radians * RAD_TO_DEG
1420 .ENDSUB
1430 SUB min(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1440 IF a < b THEN
1450 RETURN a
1460 ELSE
1470 RETURN b
1480 END IF
1490 .ENDSUB
1500 SUB max(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1510 IF a > b THEN
1520 RETURN a
1530 ELSE
1540 RETURN b
1550 END IF
1560 .ENDSUB
1570 SUB clamp(x AS NUM AS DOUBLE, lo AS NUM AS DOUBLE, hi AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1580 IF x < lo THEN
1590 RETURN lo
1600 ELSE IF x > hi THEN
1610 RETURN hi
1620 ELSE
1630 RETURN x
1640 END IF
1650 .ENDSUB
1660 SUB lerp(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, t AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1670 RETURN a + (b - a) * t
1680 .ENDSUB
1690 SUB inv_lerp(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1700 RETURN (x - a) / (b - a)
1710 .ENDSUB
1720 SUB normalize(x AS NUM AS DOUBLE, lo AS NUM AS DOUBLE, hi AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1730 RETURN (x - lo) / (hi - lo)
1740 .ENDSUB
1750 SUB smoothstep(edge0 AS NUM AS DOUBLE, edge1 AS NUM AS DOUBLE, x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1760 DIM t AS NUM AS DOUBLE AS VAR
1770 t = CALL clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
1780 RETURN t * t * (3.0 - 2.0 * t)
1790 .ENDSUB
1800 SUB sign(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS LONG
1810 IF x > 0.0 THEN
1820 RETURN 1
1830 ELSE IF x < 0.0 THEN
1840 RETURN -1
1850 ELSE
1860 RETURN 0
1870 END IF
1880 .ENDSUB
1890 SUB is_close(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, tolerance AS NUM AS DOUBLE) AS PUBLIC AS BOOL
1900 RETURN C.fabs(a - b) <= tolerance
1910 .ENDSUB
1920 SUB mean2(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1930 RETURN (a + b) / 2.0
1940 .ENDSUB
1950 SUB mean3(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1960 RETURN (a + b + c) / 3.0
1970 .ENDSUB
1980 SUB mean4(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE, d AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
1990 RETURN (a + b + c + d) / 4.0
2000 .ENDSUB
2010 SUB variance2(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2020 DIM m AS NUM AS DOUBLE AS VAR
2030 m = CALL mean2(a, b)
2040 RETURN ((a - m) * (a - m) + (b - m) * (b - m)) / 2.0
2050 .ENDSUB
2060 SUB variance3(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2070 DIM m AS NUM AS DOUBLE AS VAR
2080 m = CALL mean3(a, b, c)
2090 RETURN ((a - m) * (a - m) + (b - m) * (b - m) + (c - m) * (c - m)) / 3.0
2100 .ENDSUB
2110 SUB variance4(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE, d AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2120 DIM m AS NUM AS DOUBLE AS VAR
2130 m = CALL mean4(a, b, c, d)
2140 RETURN ((a - m) * (a - m) + (b - m) * (b - m) + (c - m) * (c - m) + (d - m) * (d - m)) / 4.0
2150 .ENDSUB
2160 SUB stddev2(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2170 RETURN C.sqrt(variance2(a, b))
2180 .ENDSUB
2190 SUB stddev3(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2200 RETURN C.sqrt(variance3(a, b, c))
2210 .ENDSUB
2220 SUB stddev4(a AS NUM AS DOUBLE, b AS NUM AS DOUBLE, c AS NUM AS DOUBLE, d AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2230 RETURN C.sqrt(variance4(a, b, c, d))
2240 .ENDSUB
2250 SUB distance2(x1 AS NUM AS DOUBLE, y1 AS NUM AS DOUBLE, x2 AS NUM AS DOUBLE, y2 AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2260 RETURN C.hypot(x2 - x1, y2 - y1)
2270 .ENDSUB
2280 SUB distance3(x1 AS NUM AS DOUBLE, y1 AS NUM AS DOUBLE, z1 AS NUM AS DOUBLE, x2 AS NUM AS DOUBLE, y2 AS NUM AS DOUBLE, z2 AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2290 RETURN C.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1) + (z2 - z1) * (z2 - z1))
2300 .ENDSUB
2310 SUB sigmoid(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2320 RETURN 1.0 / (1.0 + C.exp(0.0 - x))
2330 .ENDSUB
2340 SUB relu(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2350 RETURN max(0.0, x)
2360 .ENDSUB
2370 SUB softplus(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2380 RETURN C.log(1.0 + C.exp(x))
2390 .ENDSUB
2400 SUB gaussian_pdf(x AS NUM AS DOUBLE, mu AS NUM AS DOUBLE, sigma AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2410 DIM z AS NUM AS DOUBLE AS VAR
2420 z = (x - mu) / sigma
2430 RETURN C.exp(-0.5 * z * z) / (sigma * C.sqrt(TAU))
2440 .ENDSUB
2450 SUB gaussian_cdf(x AS NUM AS DOUBLE, mu AS NUM AS DOUBLE, sigma AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2460 RETURN 0.5 * (1.0 + C.erf((x - mu) / (sigma * SQRT2)))
2470 .ENDSUB
2480 SUB erf(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2490 RETURN C.erf(x)
2500 .ENDSUB
2510 SUB erfc(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2520 RETURN C.erfc(x)
2530 .ENDSUB
2540 SUB gamma(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2550 RETURN C.tgamma(x)
2560 .ENDSUB
2570 SUB log_gamma(x AS NUM AS DOUBLE) AS PUBLIC AS NUM AS DOUBLE
2580 RETURN C.lgamma(x)
2590 .ENDSUB
