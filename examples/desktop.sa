10 USE SYS.DESKTOP AS D
20 DIM ok AS BOOL AS VAR
30 DIM text AS STRING AS VAR
40 SUB main AS PUBLIC AS VOID
50 ok = D.CLIPBOARD_SET("hello from SonAlgebraic")
60 IF ok THEN
70 text = D.CLIPBOARD_GET()
80 ok = D.MESSAGE("SonAlgebraic", text)
90 ELSE
100 PRINT D.LAST_ERROR()
110 END IF
120 .ENDSUB
130 CALL main
140 END
