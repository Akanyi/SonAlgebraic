{
  "name": "sonalgebraic",
  "displayName": "SonAlgebraic",
  "description": "Syntax highlighting for the SonAlgebraic (.sa) language",
  "version": "0.2.1",
  "publisher": "sonalgebraic",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sonalgebraic",
        "aliases": [
          "SonAlgebraic",
          "sa"
        ],
        "extensions": [
          ".sa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sonalgebraic",
        "scopeName": "source.sonalgebraic",
        "path": "./syntaxes/sonalgebraic.tmLanguage.json"
      }
    ]
  }
}
