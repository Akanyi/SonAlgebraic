10 USEC "stdlib.h" AS STDLIB
20 DECLARE C SUB STDLIB.malloc(n AS NUM AS LONG) AS CPTR
30 DECLARE C SUB STDLIB.free(p AS CPTR) AS VOID
40 SUB main AS PUBLIC AS VOID
50 DIM raw AS CPTR AS VAR
60 raw = STDLIB.malloc(8)
70 DIM p AS PTR TO NUM AS LONG AS VAR
80 p = CAST PTR TO NUM AS LONG raw
90 ^p = 42
100 PRINT ^p
110 CALL STDLIB.free(raw)
120 .ENDSUB
130 CALL main
140 END